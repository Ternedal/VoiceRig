# Required only for first-time pyannote community-1 model access/download.
HF_TOKEN=

# ModelRig backend. Current ModelRig architecture uses Go backend on :8080.
MODELRIG_BASE_URL=http://127.0.0.1:8080

# Optional bearer token when the ModelRig import endpoint is protected by normal backend auth.
MODELRIG_TOKEN=

# Local VoiceRig data/output directory.
VOICERIG_DATA_DIR=voicerig-data

# RTX 3060 / 12 GB target: keep Chatterbox on GPU, diarization on CPU by default.
# Set diarization to cuda only if you deliberately want it to compete for VRAM.
VOICERIG_CHATTERBOX_DEVICE=auto
VOICERIG_DIARIZATION_DEVICE=cpu

# Combined upload budget for one voice build, across all files.
VOICERIG_MAX_UPLOAD_MB=2048
