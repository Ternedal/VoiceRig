# Required only for first-time pyannote community-1 model access/download.
# Accept the model conditions on Hugging Face, then place a read token here.
HF_TOKEN=

# VoiceRig is local-first. pyannote telemetry can include model origin, file
# duration and speaker-count parameters, so it is disabled unless explicitly
# opted in.
PYANNOTE_METRICS_ENABLED=0

# VoiceRig's UI/build/TTS HTTP surface is unauthenticated and therefore
# loopback-only by default at both bind and request level. Keep this at 0 for
# normal use. Set to 1 only for deliberate trusted-network development.
VOICERIG_ALLOW_LAN=0

# ModelRig backend. Current ModelRig architecture uses Go backend on :8080.
MODELRIG_BASE_URL=http://127.0.0.1:8080

# Optional bearer token when the ModelRig import endpoint is protected by normal backend auth.
MODELRIG_TOKEN=

# Optional custom VoiceRig data/output directory. Leave blank for the stable
# per-user default (%LOCALAPPDATA%\VoiceRig on Windows). Older installations
# with VOICERIG_DATA_DIR=voicerig-data are migrated automatically.
VOICERIG_DATA_DIR=

# RTX 3060 / 12 GB target: Chatterbox owns CUDA in the main venv.
VOICERIG_CHATTERBOX_DEVICE=auto

# Diarization is intentionally a separate CPU-only Python environment because
# current pyannote and Chatterbox require incompatible PyTorch versions.
# Normally auto-discovered as .venv-diarization/Scripts/python.exe.
VOICERIG_DIARIZATION_PYTHON=
VOICERIG_DIARIZATION_TIMEOUT_SECONDS=1800

# Product default is fail-closed: if speaker analysis is unavailable, VoiceRig
# refuses to guess which person to clone. Set this to 1 only for controlled
# developer tests with known single-speaker source material.
VOICERIG_ALLOW_UNDIARIZED=0

# Combined upload budget for one voice build, across all files.
VOICERIG_MAX_UPLOAD_MB=2048

# Same-host ModelRig integration. VoiceRig copies .mrvoice here and marks it default.
MODELRIG_VOICES_DIR=~/.kaliv/voices
MODELRIG_LOCAL_INSTALL=1
